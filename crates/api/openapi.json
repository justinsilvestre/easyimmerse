  "components": {
    "schemas": {
      "AddMediaFileRequest": {
        "type": "object",
        "required": [
          "name",
          "source"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "The name shown in the project's media list, usually the file name."
          },
