              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PreferenceValue"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "The value was stored"
