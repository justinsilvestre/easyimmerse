  "paths": {
    "/dictionaries": {
      "get": {
        "tags": [
          "dictionaries"
        ],
        "operationId": "listDictionaries",
        "responses": {
          "200": {
            "description": "Every imported dictionary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListDictionariesResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "421": {
            "description": "Unexpected Host header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer_token": []
          }
        ]
      },
      "post": {
        "tags": [
          "dictionaries"
        ],
        "operationId": "importDictionary",
        "requestBody": {
          "description": "The dictionary archive",
          "content": {
            "application/zip": {}
          }
        },
        "responses": {
          "201": {
            "description": "The dictionary was imported",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DictionarySummary"
                }
              }
            }
          },
          "400": {
            "description": "The archive could not be parsed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "421": {
            "description": "Unexpected Host header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer_token": []
          }
        ]
      }
    },
