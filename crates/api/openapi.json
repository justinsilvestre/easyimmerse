  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "description": "The body of every error response.",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "A stable, machine-readable identifier such as `unauthorized`."
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Chapter": {
        "type": "object",
        "required": [
          "paragraphs"
        ],
        "properties": {
          "paragraphs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Cue": {
        "type": "object",
        "description": "One text segment with the time range during which it is shown.\n\nThe text keeps any inline markup from the source file, such as `<i>`, and joins\nmultiple lines with `\\n`.",
        "required": [
          "index",
          "start_ms",
          "end_ms",
          "text"
        ],
        "properties": {
          "end_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "index": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "start_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "text": {
            "type": "string"
          }
        }
      },
      "DictionarySummary": {
        "type": "object",
        "required": [
          "id",
          "title",
          "entry_count"
        ],
        "properties": {
          "entry_count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "Document": {
        "type": "object",
        "required": [
          "title",
          "chapters"
        ],
        "properties": {
          "chapters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Chapter"
            }
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          }
        }
      },
      "DocumentFormat": {
        "type": "string",
        "enum": [
          "epub",
          "plain_text"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "ImportLocalDictionaryRequest": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string"
          }
        }
      },
      "ListDictionariesResponse": {
        "type": "object",
        "required": [
          "dictionaries"
        ],
        "properties": {
          "dictionaries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DictionarySummary"
            }
          }
        }
      },
      "ListProjectsResponse": {
        "type": "object",
        "required": [
          "projects"
        ],
        "properties": {
          "projects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectSummary"
            }
          }
        }
      },
      "LookupResponse": {
        "type": "object",
        "required": [
          "entries"
        ],
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TermEntry"
            }
          }
        }
      },
      "ParseLocalDocumentRequest": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "format": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/DocumentFormat",
                "description": "Overrides format detection."
              },
              {
                "type": "null"
              }
            ]
          },
          "path": {
            "type": "string"
          }
        }
      },
      "ParseTimedTextRequest": {
        "type": "object",
        "description": "The request body shared by the HTTP route and the WebAssembly facade.",
        "required": [
          "source"
        ],
        "properties": {
          "format": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/TimedTextFormat"
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "$ref": "#/components/schemas/TextSource"
          }
        }
      },
      "PreferenceValue": {
        "type": "object",
        "description": "A preference value. `null` means the preference has not been set.",
        "properties": {
          "value": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ProjectId": {
        "type": "string"
      },
      "ProjectSummary": {
        "type": "object",
        "required": [
          "id",
          "name",
          "language",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "description": "An RFC 3339 timestamp."
          },
          "id": {
            "$ref": "#/components/schemas/ProjectId"
          },
          "language": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "TermEntry": {
        "type": "object",
        "required": [
          "term",
          "definitions",
          "tags"
        ],
        "properties": {
          "definitions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reading": {
            "type": [
              "string",
              "null"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "term": {
            "type": "string"
          }
        }
      },
      "TextSource": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "text",
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "inline"
                ]
              },
              "text": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "path",
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "path"
                ]
              },
              "path": {
                "type": "string"
              }
            }
          }
        ],
        "description": "Where the text of a request comes from.\n\nThe `path` variant names a file on the machine running the server. The server resolves\nit, and only for requests authenticated with the per-launch token. The WebAssembly build\nsupports only the `inline` variant."
      },
      "TimedTextFormat": {
        "type": "string",
        "enum": [
          "srt",
          "vtt"
        ]
      },
      "TimedTextTrack": {
        "type": "object",
        "required": [
          "format",
          "cues"
        ],
        "properties": {
          "cues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Cue"
            }
          },
          "format": {
            "$ref": "#/components/schemas/TimedTextFormat"
