        "oneOf": [
          {
            "type": "object",
            "required": [
              "path",
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "path"
                ]
              },
              "path": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
