              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "421": {
            "description": "Unexpected Host header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer_token": []
          }
        ]
      }
    },
    "/dictionaries/{id}/lookup": {
      "get": {
        "tags": [
          "dictionaries"
        ],
        "operationId": "lookupTerm",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The dictionary id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "term",
            "in": "query",
            "description": "The exact term or reading to find.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The entries matching the term exactly",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LookupResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "No dictionary has the id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "421": {
            "description": "Unexpected Host header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer_token": []
          }
        ]
      }
    },
    "/documents/parse": {
      "post": {
        "tags": [
          "documents"
        ],
        "summary": "Parses a document sent as the raw request body.",
        "description": "The format is taken from the `format` query parameter, then from the `Content-Type`\nheader, and otherwise detected from the bytes.",
        "operationId": "parseDocument",
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "description": "Overrides format detection.",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/DocumentFormat"
            }
          }
        ],
        "requestBody": {
          "description": "The document file",
          "content": {
            "application/epub+zip": {},
            "text/plain": {}
          }
        },
        "responses": {
          "200": {
            "description": "The parsed document",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Document"
                }
              }
            }
          },
          "400": {
            "description": "The document could not be parsed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "421": {
            "description": "Unexpected Host header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer_token": []
          }
        ]
      }
    },
