{
  "name": "@easyimmerse/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3 --warnings-as-errors=false",
    "postinstall": "wxt prepare",
    "typecheck": "tsc -p tsconfig.json",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@easyimmerse/backend": "workspace:*",
    "@easyimmerse/effects-extension": "workspace:*",
    "@easyimmerse/state": "workspace:*",
    "@easyimmerse/ui": "workspace:*",
    "@easyimmerse/wasm": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@easyimmerse/config": "workspace:*",
    "@easyimmerse/fixtures": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "typescript": "~6.0.3",
    "web-ext": "^10.7.0",
    "wxt": "^0.21.4"
  }
}
