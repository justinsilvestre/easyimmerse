{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "easyImmerse",
  "version": "0.1.0",
  "identifier": "com.easyimmerse.app",
  "build": {
    "devUrl": "http://localhost:1421",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm vite:dev",
    "beforeBuildCommand": "pnpm vite:build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' http://127.0.0.1:* http://localhost:* ipc: http://ipc.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "media-src": "'self' http://127.0.0.1:*"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../packages/licenses/src/generated/ffmpeg-notices.txt": "licenses/ffmpeg-notices.txt"
    }
  }
}
